{
  "name": "kharness",
  "version": "1.3.3",
  "private": true,
  "description": "KHarness：本地 AI Harness（模型导入 / 延迟测试 / Playground），由个人网站 AI 模块导出的独立项目",
  "author": "KHarness",
  "homepage": "https://github.com/AsZhangKer/KHarness",
  "main": "desktop/main.js",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "desktop": "npm --prefix client run build && electron .",
    "desktop:raw": "electron .",
    "pack:prep": "node desktop/pack-prep.js",
    "dist": "npm run build && node desktop/pack-prep.js && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && node desktop/pack-prep.js && electron-builder --win dir",
    "dist:small": "npm run build && node desktop/pack-prep.js && set ELECTRON_BUILDER_COMPRESSION_LEVEL=9&& electron-builder --win nsis --x64",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.kharness.desktop",
    "productName": "KHarness",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/server-payload",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      },
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KHarness-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "kharness",
      "category": "Utility",
      "maintainer": "KHarness",
      "synopsis": "本地单用户 AI Agent Harness",
      "description": "KHarness：模型管理、Agent 工具调用、内置浏览器、SSH 与终端都在本机运行。无鉴权，服务只监听 127.0.0.1，数据留在用户配置目录。",
      "artifactName": "KHarness-${version}_${arch}.deb"
    },
    "flatpak": {
      "runtimeVersion": "23.08",
      "baseVersion": "23.08",
      "category": "Utility",
      "useWaylandFlags": true,
      "synopsis": "本地单用户 AI Agent Harness",
      "description": "KHarness：模型管理、Agent 工具调用、内置浏览器、SSH 与终端都在本机运行。无鉴权，服务只监听 127.0.0.1，数据留在用户配置目录。",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--filesystem=host",
        "--device=all",
        "--allow=devel"
      ],
      "artifactName": "KHarness-${version}-${arch}.flatpak"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KHarness",
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist",
    "compression": "store"
  }
}
